<!-- Pick-up task: SO-101 + a 355 ml can (66 mm x 122 mm, full) standing on the desk (z = 0). The can pose is set per
     seed by the harness.
     Arm collision geoms: contype 1 / conaffinity 0 -> the arm collides with the desk and the can, not with itself
     (convex hulls of neighbouring links would otherwise report false contacts). -->
<mujoco model="task_pick_can">
  <include file="so101_task_robot.xml"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global offwidth="1280" offheight="960"/>
  </visual>
  <asset>
    <texture type="2d" name="desk" builtin="checker" rgb1="0.82 0.80 0.76" rgb2="0.78 0.76 0.72" width="300" height="300"/>
    <material name="desk" texture="desk" texuniform="true" texrepeat="8 8"/>
  </asset>
  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <geom name="desk" type="plane" size="0 0 0.05" material="desk" contype="1" conaffinity="1" friction="1 0.005 0.0001"/>
    <body name="can" pos="0.2 0 0.061">
      <freejoint name="can"/>
      <geom name="can" type="cylinder" size="0.033 0.061" rgba="0.45 0.75 0.2 1" mass="0.37"
            contype="1" conaffinity="1" friction="1.0 0.01 0.0001" condim="4"/>
    </body>
    <!-- Fixed overview camera (simulation only), front-right of the arm, looking at the work area. -->
    <camera name="scene" pos="0.45 -0.35 0.45" xyaxes="0.62 0.78 0 -0.45 0.36 0.82" fovy="42"/>
  </worldbody>
</mujoco>
